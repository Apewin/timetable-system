[Unit]
Description=Back up AP timetable state

[Service]
Type=oneshot
User=timetable
Group=timetable
Environment=STATE_FILE=/var/lib/timetable/timetable.json
Environment=BACKUP_DIR=/var/backups/timetable
ExecStart=/opt/timetable/current/deploy/timetable-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups/timetable
